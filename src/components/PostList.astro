---
import type { CollectionEntry } from "astro:content";
import { formatDate } from "../lib/utils";

interface Props {
  posts: CollectionEntry<"posts">[];
  emptyText?: string;
  compact?: boolean;
}

const { posts, emptyText = "暂无文章", compact = false } = Astro.props;
const itemPadding = compact ? "py-2" : "py-3";
---

{
  posts.length === 0 ? (
    <p class="text-sm text-zinc-500 dark:text-zinc-400">{emptyText}</p>
  ) : (
    <ul class="m-0 flex list-none flex-col p-0 text-sm" role="list">
      {posts.map((post) => (
        <li class="m-0 list-none p-0">
          <a
            href={`/posts/${post.slug}`}
            class={`group grid gap-1 ${itemPadding} no-underline transition-colors sm:grid-cols-[1fr_auto] sm:items-baseline sm:gap-6`}
          >
            <span class="font-medium leading-snug text-zinc-900 transition-colors group-hover:text-blue-600 dark:text-zinc-100 dark:group-hover:text-blue-400">
              {post.data.title}
            </span>
            <time
              datetime={post.data.date.toISOString()}
              class="font-mono text-xs text-zinc-500 dark:text-zinc-500"
            >
              {formatDate(post.data.date)}
            </time>
          </a>
        </li>
      ))}
    </ul>
  )
}
