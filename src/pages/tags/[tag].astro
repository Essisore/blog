---
import PostList from "../../components/PostList.astro";
import { SITE_TITLE } from "../../consts";
import Layout from "../../layouts/Layout.astro";
import { getPublishedPosts } from "../../lib/posts";

export async function getStaticPaths() {
  const publishedPosts = await getPublishedPosts();

  const uniqueTags = [
    ...new Set(publishedPosts.flatMap((post) => post.data.tags || [])),
  ].filter(Boolean);

  return uniqueTags.map((tag) => {
    const filteredPosts = publishedPosts
      .filter((post) => post.data.tags?.includes(tag))
      .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

    return {
      params: { tag },
      props: { posts: filteredPosts },
    };
  });
}

const { tag } = Astro.params;
const { posts } = Astro.props;

const pageTitle = `标签: ${tag} - ${SITE_TITLE}`;
---

<Layout
  title={pageTitle}
  description={`标签 #${tag} 下的所有文章`}
  containerClass="max-w-3xl"
  className="py-10"
>
  <main class="space-y-8">
    <header
      class="flex flex-col gap-4 border-b border-zinc-200 pb-4 dark:border-zinc-800 sm:flex-row sm:items-end sm:justify-between"
    >
      <div>
        <p class="text-sm text-zinc-500 dark:text-zinc-400">标签</p>
        <h1 class="mt-1 text-xl font-semibold text-zinc-950 dark:text-zinc-50">
          #{tag}
        </h1>
        <p class="mt-2 text-sm text-zinc-500 dark:text-zinc-400">
          共 {posts.length} 篇文章
        </p>
      </div>
      <a
        href="/tags"
        class="text-sm text-zinc-500 no-underline transition-colors hover:text-blue-600 dark:hover:text-blue-400"
      >
        所有标签 &rarr;
      </a>
    </header>

    <PostList posts={posts} compact />
  </main>
</Layout>
